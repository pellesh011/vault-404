# Telegram
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_CHANNEL_ID=
TELEGRAM_SESSION_NAME=vault_session
TELEGRAM_MAX_CONCURRENT=10
TELEGRAM_PROXY_TYPE=
TELEGRAM_PROXY_ADDR=
TELEGRAM_PROXY_PORT=
TELEGRAM_PROXY_USERNAME=
TELEGRAM_PROXY_PASSWORD=

# Database
DATABASE_URL=postgresql+asyncpg://vault404:vault404@localhost:5432/vault404
POSTGRES_DB=vault404
POSTGRES_USER=vault404
POSTGRES_PASSWORD=vault404
POSTGRES_TEST_DB=vault404_test

# Samba
WORKGROUP=VAULTFS
SAMBA_USER=vaultfs;vaultfs

# Cache
CACHE_L1_MAX_SIZE=104857600
CACHE_L2_PATH=/tmp/vaultfs-cache
CACHE_L2_MAX_SIZE=1073741824

# Mount
MOUNTPOINT=/mnt/vault
CHUNK_SIZE=65536
