# Telegram
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_CHANNEL_ID=
TELEGRAM_SESSION_NAME=vault_session
TELEGRAM_MAX_CONCURRENT=10

# Database
DATABASE_URL=postgresql+asyncpg://vault404:vault404@localhost:5432/vault404

# Cache
CACHE_L1_MAX_SIZE=104857600
CACHE_L2_PATH=/tmp/vaultfs-cache
CACHE_L2_MAX_SIZE=1073741824

# Mount
MOUNTPOINT=/mnt/vault
CHUNK_SIZE=65536
